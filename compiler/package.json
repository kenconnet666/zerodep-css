  "description": "Shared Vue/Svelte CSS template compiler, isolated from the CSS runtime.",
  "author": "kenconnet666",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-css.git",
    "directory": "compiler"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-css#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-css/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
