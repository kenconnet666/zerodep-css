{
  "name": "zerodep-css-compiler",
  "version": "0.3.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zerodep-css": "workspace:*",
    "typescript": "catalog:",
    "magic-string": "catalog:"
  },
