{
  "name": "@zerodep-css/svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "zerodep-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@zerodep-css/core": "workspace:^",
    "magic-string": "catalog:",
    "typescript": "catalog:",
    "@jridgewell/sourcemap-codec": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "svelte": "catalog:"
  },
  "description": "Svelte 原生响应式 CSS 与自动编译接入",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-css.git",
    "directory": "svelte"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-css"
}
