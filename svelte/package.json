{
  "name": "@zerodep-css/svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "node": "./dist/vite.js"
    },
    "./bindings": {
      "node": {
        "types": "./dist/types/bindings-server.d.ts",
        "default": "./dist/bindings-server.js"
      },
      "types": "./dist/types/bindings.d.ts",
      "default": "./dist/bindings.js"
    },
    ".": {
      "node": {
        "types": "./dist/types/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "node": "./dist/server.js"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "check": "svelte-check --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@zerodep-css/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:"
  }
}
