{
  "name": "@zerodep-css/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "zerodep-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler-runtime": {
      "types": "./dist/compiler-runtime.d.ts",
      "default": "./dist/compiler-runtime.js"
    },
    "./theme-runtime": {
      "zerodep-source": "./src/theme-runtime.ts",
      "types": "./dist/theme-runtime.d.ts",
      "default": "./dist/theme-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "css-tree": "catalog:"
  },
  "description": "强类型 CSS 运行时、主题与 SSR 样式管理",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-css.git",
    "directory": "core"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-css"
}
