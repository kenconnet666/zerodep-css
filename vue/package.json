{
  "name": "@zerodep-css/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "zerodep-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./compiler-runtime": {
      "types": "./dist/compiler-runtime.d.ts",
      "default": "./dist/compiler-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zerodep-css/core": "workspace:^",
    "magic-string": "catalog:",
    "typescript": "catalog:",
    "@jridgewell/sourcemap-codec": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "vue": "catalog:"
  },
  "description": "Vue 原生响应式 CSS 与自动编译接入",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-css.git",
    "directory": "vue"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-css"
}
