{
  "name": "zerodep-css-vue",
  "version": "0.3.3",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "node": "./dist/vite.js"
    },
    "./bindings": {
      "node": {
        "types": "./dist/types/bindings-server.d.ts",
        "default": "./dist/bindings-server.js"
      },
      "types": "./dist/types/bindings.d.ts",
      "default": "./dist/bindings.js"
    },
    ".": {
      "node": {
        "types": "./dist/types/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "node": "./dist/server.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt/index.d.ts",
      "node": "./dist/nuxt/index.js"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "check": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vue/compiler-dom": "catalog:",
    "zerodep-css": "workspace:*",
    "zerodep-css-compiler": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@nuxt/kit": "^4.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:languageServices",
    "typescript": "catalog:",
    "@nuxt/kit": "catalog:",
    "nuxt": "catalog:"
  },
  "description": "Runtime CSS, implicit variable transforms and Nuxt integration for Vue 3.5.",
  "author": "kenconnet666",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-css.git",
    "directory": "vue"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-css#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-css/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    }
  }
}
