{
  "name": "zerodep-css-research",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "check": "pnpm css:generate:check && pnpm -r run build:types && pnpm -r run check && pnpm test:types",
    "build": "node scripts/build-packages.mjs && pnpm -r run build:types",
    "test:author": "node --test core/test/package/author.test.mjs",
    "test:theme": "node --test core/test/package/theme.test.mjs",
    "test:bindings": "node --test core/test/package/bindings.test.mjs",
    "test:compiler": "node --test test/compiler-diagnostics.test.mjs test/component-syntax.test.mjs test/vue-template-cache.test.mjs test/svelte-template-bindings.test.mjs",
    "test:lifecycle": "node test/browser/lifecycle-hmr.mjs",
    "test:types": "node scripts/check-package-types.mjs",
    "css:generate": "node scripts/generate-css-author.mjs --write",
    "css:generate:check": "node scripts/generate-css-author.mjs --check",
    "format:check": "prettier --check README.md AGENTS.md package.json pnpm-workspace.yaml tsconfig*.json .codex scripts docs core vue svelte nuxt sveltekit test .research .github",
    "lsp:setup": "pwsh -NoProfile -File scripts/language-services/setup.ps1",
    "lsp:verify": "node scripts/language-services/verify.mjs .",
    "lsp:inspect": "node scripts/language-services/inspect.mjs .",
    "test:coverage": "node scripts/test-runtime.mjs"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:languageServices",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "@vue/language-server": "catalog:languageServices",
    "@vue/typescript-plugin": "catalog:languageServices",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-language-server": "catalog:languageServices",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:languageServices",
    "typescript-svelte-plugin": "catalog:languageServices",
    "vscode-jsonrpc": "catalog:languageServices",
    "vue": "catalog:",
    "vue-tsc": "catalog:languageServices",
    "zod": "catalog:languageServices"
  }
}
